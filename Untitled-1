def filehandling(decks): 
    # the paramater decks is used in this function to allow thr for loop to iterate through the code the correct number of times
    file.open("flashcardecks.txt", "w")
    # this opens the file flashcards and formats the file to allow 
    for deck in decks: 
        # this type of for loop means that the variable deck changes each iteration for the length of the variable decks which is an array 
        file.write(deck + ",")
        # this seperates the decks by commas to make sure they can be easily split when reading the file 
